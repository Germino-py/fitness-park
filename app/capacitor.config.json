{
  "appId": "fr.hmgfitness.app",
  "appName": "HMG Fitness",
  "webDir": "www",
  "backgroundColor": "#05070d",
  "loggingBehavior": "none",
  "ios": {
    "contentInset": "never",
    "backgroundColor": "#05070d",
    "scrollEnabled": false,
    "allowsLinkPreview": false,
    "preferredContentMode": "mobile",
    "appendUserAgent": "HMGFitness/1.0 (+https://hmgfitness.fr)"
  },
  "android": { "allowMixedContent": false, "backgroundColor": "#05070d" },
  "plugins": {
    "SplashScreen": { "launchShowDuration": 600, "launchAutoHide": false, "backgroundColor": "#05070d", "showSpinner": false },
    "StatusBar": { "overlaysWebView": true, "style": "DARK" },
    "LocalNotifications": { "iconColor": "#c8ff1e" },
    "Keyboard": { "resize": "native", "style": "DARK" }
  }
}
